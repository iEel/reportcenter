# ===========================================
# ReportCenter — Environment Variables
# Copy this file to .env and fill in values
# ===========================================

# --- Central Database (ReportCenterDB) ---
DB_USER=sa
DB_PASSWORD=YOUR_PASSWORD
DB_SERVER=192.168.110.106
DB_DATABASE=ReportCenterDB
DB_INSTANCE=alpha
DB_REQUEST_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000
DB_POOL_MIN=2
DB_POOL_MAX=20

# --- JWT Secret (MUST change in production!) ---
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_STRING

# --- Company 1: SNI (Sonic Interfreight) ---
C1_DB_USER=smf
C1_DB_PASSWORD=YOUR_PASSWORD
C1_DB_SERVER=192.168.110.200
C1_DB_DATABASE=SONIC2021
C1_DB_INSTANCE=SONIC

# --- Company 2: GRL (Grandlink Logistics) ---
C2_DB_USER=smf
C2_DB_PASSWORD=YOUR_PASSWORD
C2_DB_SERVER=192.168.110.200
C2_DB_DATABASE=GLEDB2014
C2_DB_INSTANCE=GLINK

# --- Company 3: SALOG (Sonic Autologis) ---
C3_DB_USER=smf
C3_DB_PASSWORD=YOUR_PASSWORD
C3_DB_SERVER=192.168.110.200
C3_DB_DATABASE=SMF-AUTOLOGIS
C3_DB_INSTANCE=AUTOLOGIS

# --- Cron Secret (protects /api/cron/execute-schedules) ---
CRON_SECRET=CHANGE_ME_TO_A_RANDOM_STRING

# --- Email: Microsoft Graph API (preferred) ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
SMTP_USER=report@yourcompany.com

# --- Email: SMTP Fallback ---
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_PASSWORD=

# --- LDAP / Active Directory ---
LDAP_BIND_DN=CN=ServiceAccount,OU=ServiceAccounts,DC=yourcompany,DC=com
LDAP_BIND_PASSWORD=YOUR_LDAP_PASSWORD

# --- Timeout Settings (milliseconds, optional — defaults shown) ---
REPORT_REQUEST_TIMEOUT=120000         # 120s — report execution (table view)
BACKGROUND_JOB_TIMEOUT=900000         # 900s — background job (large export, 15 min)
